VITE_GROQ_API_KEY=your_groq_api_key_here

# ===== LOCAL / DEVELOPMENT =====
# Aktif untuk menjalankan CMS di mesin lokal (Laravel di port 8000)
VITE_CMS_API_URL=http://127.0.0.1:8000/api

# ===== PRODUCTION =====
# Aktifkan (uncomment) hanya saat build/deploy ke production.
# Pastikan baris LOCAL di atas dikomentari/dihapus agar tidak tertimpa.
# VITE_CMS_API_URL=https://api.your-domain.com
